# Stripe (server only — never expose the secret key in client code)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Optional: pre-created recurring Price IDs from the Stripe Dashboard.
# If omitted, the API creates subscription prices with locked server-side amounts.
STRIPE_PRICE_TIER1=price_xxx
STRIPE_PRICE_TIER2=price_xxx
STRIPE_PRICE_TIER3=price_xxx

# Public site origin used for Checkout success/cancel URLs
SITE_URL=https://4wardwebdesign.com

# Optional webhook (Zapier / Make / n8n) to receive company details + logo payload
ONBOARDING_WEBHOOK_URL=
