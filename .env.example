# Stripe (server only — never expose the secret key in client code)
# Use sk_live_ / pk_live_ for real charges. Test keys (sk_test_ / pk_test_) will not take live payments.
STRIPE_SECRET_KEY=sk_live_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Optional: pre-created recurring Price IDs from the Stripe Dashboard.
STRIPE_PRICE_TIER1=price_xxx
STRIPE_PRICE_TIER2=price_xxx
STRIPE_PRICE_TIER3=price_xxx

# Public site origin used for Checkout success/cancel URLs
SITE_URL=https://4wardwebdesign.com

# Supabase (Admin auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Onboarding form email delivery uses Static Forms (apiKey in onboarding.html).
# Endpoint: https://api.staticforms.dev/submit
